<?php

use Contao\StringUtil;

$classes = trim($this->elementClass.' link-list--'.$this->linkListStyle.' link-list--align-'.$this->linkListAlign);
$ariaLabel = $this->headlineText ?: 'Links';

?>

<nav<?php if ($this->elementId): ?> id="<?= StringUtil::specialchars($this->elementId) ?>"<?php endif; ?> class="<?= StringUtil::specialchars($classes) ?>" aria-label="<?= StringUtil::specialchars($ariaLabel) ?>">
  <?php if ($this->headlineText): ?>
    <<?= $this->headlineUnit ?> class="link-list__headline"><?= StringUtil::specialchars($this->headlineText) ?></<?= $this->headlineUnit ?>>
  <?php endif; ?>

  <?php if (!empty($this->linkListItems)): ?>
    <ul class="link-list__items">
      <?php foreach ($this->linkListItems as $item): ?>
        <li class="link-list__item">
          <a class="link-list__link" href="<?= StringUtil::specialchars($item['url']) ?>"<?php if ($item['target']): ?> target="_blank" rel="noopener noreferrer"<?php endif; ?> aria-label="<?= StringUtil::specialchars($item['label']) ?>">
            <?php if ('' !== $item['icon']): ?>
              <span class="link-list__icon link-list__icon--<?= StringUtil::specialchars($item['icon']) ?>" aria-hidden="true"></span>
            <?php endif; ?>
            <span class="link-list__label"><?= StringUtil::specialchars($item['label']) ?></span>
            <?php if ('' !== $item['description']): ?>
              <span class="link-list__description"><?= StringUtil::specialchars($item['description']) ?></span>
            <?php endif; ?>
          </a>
        </li>
      <?php endforeach; ?>
    </ul>
  <?php endif; ?>
</nav>
